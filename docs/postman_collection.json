{
  "info": {
    "name": "mobie Hackathon Voice Integration",
    "description": "Direct calls to the organizer-approved voice API. No Auth0 login or local starter required. Set the organizer-supplied origin and secret, a registered test passenger phone and a unique call_id in private local values. Run manually. Booking defaults to confirmed:false; change only after consent. Retain the same idempotency_key for retries of the same write; use a new key for a new action. See docs/voice-integration.md. The final-report request targets the local starter with its own starter_api_key. See docs/call-logs.md for automatic tool logging and provider event setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{voice_integration_secret}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "mobie_api_url",
      "value": "https://api-staging.mobie.at"
    },
    {
      "key": "voice_integration_secret",
      "value": ""
    },
    {
      "key": "caller_phone",
      "value": ""
    },
    {
      "key": "call_id",
      "value": ""
    },
    {
      "key": "ride_time",
      "value": "REPLACE_WITH_FUTURE_ISO_DATETIME_WITH_OFFSET"
    },
    {
      "key": "ride_id",
      "value": "REPLACE_WITH_SELECTED_RIDE_ID"
    },
    {
      "key": "booking_id",
      "value": "REPLACE_WITH_BOOKING_ID"
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "starter_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "starter_api_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Verify caller",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/caller",
        "description": "Use the registered staging test passenger phone. Returns userId, firstName and savedPlaces; no booking is submitted."
      }
    },
    {
      "name": "2. Search rides",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/rides/search",
        "description": "Replace the resolved locations and future time. Response is an array; [] means no results. Select ride.id.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departure\": {\n    \"publicName\": \"Muthgasse 24, Wien\",\n    \"addressLine\": \"Muthgasse 24, 1190 Wien\",\n    \"longitude\": 16.365,\n    \"latitude\": 48.24\n  },\n  \"destination\": {\n    \"publicName\": \"Stephansplatz, Wien\",\n    \"longitude\": 16.3738,\n    \"latitude\": 48.2082\n  },\n  \"time\": \"{{ride_time}}\",\n  \"seatsRequested\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Submit booking AFTER consent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/rides/{{ride_id}}/join-detailed",
        "description": "Set confirmed:true only after spoken consent. Use the passenger searched trip and a stable unique idempotency_key. Success still needs driver approval.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departure\": {\n    \"publicName\": \"Muthgasse 24, Wien\",\n    \"addressLine\": \"Muthgasse 24, 1190 Wien\",\n    \"longitude\": 16.365,\n    \"latitude\": 48.24\n  },\n  \"destination\": {\n    \"publicName\": \"Stephansplatz, Wien\",\n    \"longitude\": 16.3738,\n    \"latitude\": 48.2082\n  },\n  \"time\": \"{{ride_time}}\",\n  \"seatsRequested\": 1,\n  \"confirmed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Check booking status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/bookings?page=0",
        "description": "Follow nextPage until null, even if an intermediate page is empty. PENDING is not driver approval."
      }
    },
    {
      "name": "5. Check selected booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/bookings/{{booking_id}}",
        "description": "Returns the latest status of one caller-owned booking."
      }
    },
    {
      "name": "6. Passenger details AFTER approval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Mobie-Caller-Phone",
            "value": "{{caller_phone}}"
          },
          {
            "key": "X-Mobie-Call-Id",
            "value": "{{call_id}}"
          }
        ],
        "url": "{{mobie_api_url}}/integrations/voice/rides/{{ride_id}}/rider-detail",
        "description": "Requires driver approval in the staging app."
      }
    },
    {
      "name": "Upload final call report via starter (manual test)",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{starter_api_key}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{starter_url}}/api/calls/{{call_id}}",
        "description": "Use a unique call_id and your local starter_api_key; replace the illustrative timestamps and conversation with actual provider values. No caller headers needed. Returns 204 after backend persistence. This request creates/updates a log only, never a ride or booking. Repeat the same IDs on retry.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"call\": {\n    \"id\": \"{{call_id}}\",\n    \"type\": \"webCall\",\n    \"startedAt\": \"2026-11-06T10:00:00Z\",\n    \"endedAt\": \"2026-11-06T10:01:00Z\",\n    \"transcript\": \"Anrufer: Hallo!\\nAssistent: Wohin möchtest du fahren?\"\n  },\n  \"messages\": [\n    {\n      \"seq\": 0,\n      \"role\": \"user\",\n      \"text\": \"Hallo!\",\n      \"secondsFromStart\": 0\n    },\n    {\n      \"seq\": 1,\n      \"role\": \"assistant\",\n      \"text\": \"Wohin möchtest du fahren?\",\n      \"secondsFromStart\": 1\n    }\n  ],\n  \"toolCalls\": [],\n  \"reportReceived\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
