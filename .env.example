# Organizer-approved staging origin and team integration secret. Never use production.
MOBIE_API_URL=https://api-staging.mobie.at
VOICE_INTEGRATION_SECRET=
PORT=3000
HOST=127.0.0.1
# Generated by setup. Protects YOUR starter; never sent upstream to mobie.
STARTER_API_KEY=
# Optional, your own Mapbox Geocoding v6 permanent=true token.
MAPBOX_ACCESS_TOKEN=
# Used ONLY by example:search for manual tests, never as a server fallback identity.
MOBIE_CALLER_PHONE=
# Set webCall only for a manual test without a phone and an organizer-assigned web test user.
MOBIE_CALL_TYPE=
